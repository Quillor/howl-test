{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/lesson", "destination": "/lesson/index.html" },
    { "source": "/post/:id", "destination": "/" },
    { "source": "/(events|alerts|profile)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/design-system(.html)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
