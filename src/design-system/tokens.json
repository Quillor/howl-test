{
  "$description": "Howl design tokens. Source: explorations/final-direction.md. Semantic colors carry Light and Dark modes in $extensions.mode.",
  "color": {
    "$type": "color",
    "gray": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f2f2f2" },
      "200": { "$value": "#d4d4d4" },
      "400": { "$value": "#8a8a8a" },
      "600": { "$value": "#5c5c5c" },
      "800": { "$value": "#2b2b2b" },
      "850": { "$value": "#1c1c1c" },
      "900": { "$value": "#0a0a0a" },
      "1000": { "$value": "#000000" }
    },
    "amber": {
      "500": { "$value": "#ffc21a" },
      "700": { "$value": "#7a5200" }
    },
    "wolfpack-red": {
      "500": { "$value": "#e01b1b" },
      "600": { "$value": "#cc0000" },
      "800": { "$value": "#990000" }
    },
    "green": {
      "400": { "$value": "#4ade80" },
      "700": { "$value": "#17703a" }
    },
    "red": {
      "400": { "$value": "#ff6b6b" },
      "700": { "$value": "#b3261e" }
    },
    "background": {
      "$value": "{color.gray.0}",
      "$extensions": { "mode": { "Light": "{color.gray.0}", "Dark": "{color.gray.1000}" } }
    },
    "surface": {
      "$value": "{color.gray.50}",
      "$extensions": { "mode": { "Light": "{color.gray.50}", "Dark": "{color.gray.850}" } }
    },
    "border": {
      "$value": "{color.gray.200}",
      "$extensions": { "mode": { "Light": "{color.gray.200}", "Dark": "{color.gray.800}" } }
    },
    "border-strong": {
      "$value": "{color.gray.400}",
      "$extensions": { "mode": { "Light": "{color.gray.400}", "Dark": "{color.gray.400}" } }
    },
    "text": {
      "$value": "{color.gray.900}",
      "$extensions": { "mode": { "Light": "{color.gray.900}", "Dark": "{color.gray.50}" } }
    },
    "text-muted": {
      "$value": "{color.gray.600}",
      "$extensions": { "mode": { "Light": "{color.gray.600}", "Dark": "{color.gray.400}" } }
    },
    "accent": {
      "$value": "{color.wolfpack-red.600}",
      "$extensions": { "mode": { "Light": "{color.wolfpack-red.600}", "Dark": "{color.wolfpack-red.600}" } }
    },
    "accent-hover": {
      "$value": "{color.wolfpack-red.800}",
      "$extensions": { "mode": { "Light": "{color.wolfpack-red.800}", "Dark": "{color.wolfpack-red.500}" } }
    },
    "on-accent": {
      "$value": "{color.gray.0}",
      "$extensions": { "mode": { "Light": "{color.gray.0}", "Dark": "{color.gray.0}" } }
    },
    "accent-text": {
      "$value": "{color.wolfpack-red.600}",
      "$extensions": { "mode": { "Light": "{color.wolfpack-red.600}", "Dark": "{color.red.400}" } }
    },
    "focus": {
      "$value": "{color.gray.1000}",
      "$extensions": { "mode": { "Light": "{color.gray.1000}", "Dark": "{color.gray.0}" } }
    },
    "success": {
      "$value": "{color.green.700}",
      "$extensions": { "mode": { "Light": "{color.green.700}", "Dark": "{color.green.400}" } }
    },
    "warning": {
      "$value": "{color.amber.700}",
      "$extensions": { "mode": { "Light": "{color.amber.700}", "Dark": "{color.amber.500}" } }
    },
    "error": {
      "$value": "{color.red.700}",
      "$extensions": { "mode": { "Light": "{color.red.700}", "Dark": "{color.red.400}" } }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Space Grotesk" },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "18": { "$value": "18px" },
      "24": { "$value": "24px" }
    }
  },
  "space": {
    "$type": "dimension",
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "soft": { "$value": "12px" },
    "pill": { "$value": "999px" }
  }
}
